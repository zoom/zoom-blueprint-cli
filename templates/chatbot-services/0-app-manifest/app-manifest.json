{
    "manifest": {
        "display_information": {
            "display_name": "{{APP_NAME}}",
            "discover_type": "LISTED",
            "install_type": "APP_DIRECTORY"
        },
        "oauth_information": {
            "usage": "USER_OPERATION",
            "development_redirect_uri": "{{DEV_BASE_URL}}/auth/callback",
            "production_redirect_uri": "",
            "oauth_allow_list": [
                "{{DEV_BASE_URL}}/auth/callback"
            ],
            "strict_mode": false,
            "subdomain_strict_mode": false,
            "scopes": [
                {
                    "scope": "team_chat:read:user_message",
                    "optional": false
                },
                {
                    "scope": "imchat:userapp",
                    "optional": false
                },
                {
                    "scope": "marketplace:read:app",
                    "optional": false
                },
                {
                    "scope": "message:write:content",
                    "optional": false
                },
                {
                    "scope": "zoomapp:inmeeting",
                    "optional": false
                },
                {
                    "scope": "app:channel_content:write",
                    "optional": false
                }
            ]
        },
        "features": {
            "products": [
                "ZOOM_CHAT"
            ],
            "development_home_uri": "{{DEV_BASE_URL}}/webview",
            "production_home_uri": "",
            "domain_allow_list": [
                {
                    "domain": "appssdk.zoom.us",
                    "explanation": "Zoom Apps SDK"
                },
                {
                    "domain": "{{DEV_HOSTNAME}}",
                    "explanation": "Development app host"
                }
            ],
            "in_client_feature": {
                "zoom_app_api": {
                    "enable": true,
                    "zoom_app_apis": [
                        "composeCard",
                        "getAppContext",
                        "getChatContext",
                        "getRunningContext",
                        "getSupportedJsApis",
                        "getUserContext",
                        "sendMessageToChat"
                    ]
                },
                "guest_mode": {
                    "enable": false,
                    "enable_test_guest_mode": false
                },
                "in_client_oauth": {
                    "enable": false
                },
                "collaborate_mode": {
                    "enable": false,
                    "enable_screen_sharing": false,
                    "enable_play_together": false,
                    "enable_start_immediately": false,
                    "enable_join_immediately": false
                },
                "team_chat_tab": {
                    "enable_home_tab": false,
                    "enable_channel_tab": false
                }
            },
            "zoom_client_support": {
                "mobile": {
                    "enable": false
                },
                "zoom_room": {
                    "enable": false,
                    "enable_personal_zoom_room": false,
                    "enable_shared_zoom_room": false,
                    "enable_digital_signage": false,
                    "enable_zoom_rooms_controller": false
                },
                "pwa_client": {
                    "enable": false
                }
            },
            "embed": {
                "meeting_sdk": {
                    "enable": false,
                    "enable_device": false,
                    "devices": []
                },
                "contact_center_sdk": {
                    "enable": false
                },
                "phone_sdk": {
                    "enable": false
                }
            },
            "team_chat_subscription": {
                "enable": true,
                "enable_support_channel": false,
                "slash_command": {
                    "command": "",
                    "command_hints": [],
                    "enable_add_to_channel": false,
                    "enable_mention": true,
                    "development_message_url": "{{DEV_BASE_URL}}/webhooks",
                    "production_message_url": "",
                    "sender_type": "zoom",
                    "welcome_msg": {
                        "title": "",
                        "body": ""
                    },
                    "trust_domain_list": []
                },
                "shortcuts": []
            },
            "event_subscription": {
                "enable": true,
                "events": [
                    {
                        "subscription_name": "Chatbot Service",
                        "event_types": [
                            "chat_message.sent",
                            "chat_message.replied",
                            "team_chat.channel_app_removed",
                            "team_chat.channel_app_added"
                        ],
                        "development_webhook_url": "{{DEV_BASE_URL}}/webhooks",
                        "event_usage": "EVENT_FOR_USER",
                        "communicate_type": "WEB_HOOK"
                    }
                ]
            },
            "custom_form": {
                "enable": false
            },
            "marketplace_actions": {
                "enable": false
            },
            "marketplace_triggers": {
                "enable": false
            },
            "plugin_sdk": {
                "enable": false
            }
        }
    }
}
