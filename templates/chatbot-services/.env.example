# ─── Zoom App Credentials ─────────────────────────────────────────────────────
# Found in: Zoom App Marketplace → Your App → App Credentials
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_ACCOUNT_ID=your_zoom_account_id_here

# ─── Zoom Chat Bot Settings ──────────────────────────────────────────────
# Found in: Zoom App Marketplace → Your App → Features → Surface → Chat subscription
ZOOM_BOT_JID=your_bot_jid_here
# Found in: Features → Access → Token → Secret token
ZOOM_VERIFICATION_TOKEN=your_verification_token_here
# Your bot's display name (e.g. "Zoom Service Chatbot"). Used to strip the bot's
# @mention from channel messages so the user's actual text is parsed correctly.
ZOOM_BOT_NAME=your_bot_display_name_here

# ─── OAuth Redirect ───────────────────────────────────────────────────────────
# Must match the redirect URI registered in your Zoom App settings exactly.
# During development: https://your-ngrok-url.ngrok-free.app/auth/callback
ZOOM_REDIRECT_URI=https://your_tunnel_url_here/auth/callback

# ─── Zoom App Webview ─────────────────────────────────────────────────────────
# Public URL of the in-client Zoom App webview, used by the "Open App" button.
# Optional — if unset, it defaults to the origin of ZOOM_REDIRECT_URI + /webview.
# WEBVIEW_URL=https://your-ngrok-url.ngrok-free.app/webview

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com/
# Optional for local Zoom setup. Set a real key to enable Claude replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Backs flow state, form drafts, conversation history, and the cached Zoom token.
# OPTIONAL for local development: if left as placeholders/unset, the app falls back
# to an in-memory store (not shared across restarts). REQUIRED for production so
# state persists and is shared across instances.
# Create a database at https://console.upstash.com/ and copy its REST URL + token.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ─── Server ───────────────────────────────────────────────────────────────────
# Set NODE_ENV=production in deployment: hides internal error details and enables
# secure session cookies. SESSION_SECRET is REQUIRED when NODE_ENV=production.
NODE_ENV=development
PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string-in-production
FRONTEND_ORIGIN=http://localhost:3000

# ─── Zoom for Government (optional) ───────────────────────────────────────────
# Leave unset for commercial Zoom. For Zoom for Government, uncomment:
# ZOOM_OAUTH_BASE_URL=https://zoomgov.com
# ZOOM_API_BASE_URL=https://api.zoomgov.com/v2
