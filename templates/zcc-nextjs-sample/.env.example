# Public origin used by the Next.js development configuration.
# zoom dev refreshes this value from ngrok or --url.
SITE_URL=http://localhost:3000


# The created General App credentials. The CLI fills these when provisioning.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Updated by zoom dev to match the public HTTPS origin.
ZOOM_REDIRECT_URI=http://localhost:3000/auth/callback
