{
  "name": "create-zoom-agent",
  "version": "0.2.0",
  "description": "Zoom Blueprint CLI scaffolds Zoom Workplace apps. Interactive CLI that scaffolds, configures, and runs AI agents for Zoom Workplace using public PKCE management authentication.",
  "type": "module",
  "bin": {
    "create-zoom-agent": "dist/index.js",
    "zoom": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    ".env.example",
    "docs"
  ],
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "zoom",
    "zoom-workplace",
    "ai-agent",
    "cli",
    "scaffold",
    "marketplace"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "chalk": "^5.3.0",
    "commander": "^15.1.0",
    "tar": "^7.4.3"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
